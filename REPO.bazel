# Directories that hold no source of this repository: VCS metadata, Python
# environments, tool caches, agent worktrees, scratch work and Obsidian's
# vault settings. Ignoring them keeps them out of every package and every
# glob, so the whole-tree checks (//:repo_files) never scan them.
ignore_directories([
    ".git",
    # Bazel convenience symlinks (--symlink_prefix=.bazel-). The old bazel-*
    # links stay listed for one transition: clones that have not run Bazel
    # since the prefix change still have them.
    ".bazel-*",
    "bazel-*",
    ".bazel_env",
    ".mise",
    ".venv",
    "tmp",
    ".worktrees",
    ".claude/worktrees",
    "**/__pycache__",
    "**/.*_cache",
    ".hypothesis",
    ".mypy_cache",
    "node_modules",
    ".obsidian",
])
